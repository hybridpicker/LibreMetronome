{
  "name": "frontend",
  "version": "0.6.0",
  "private": true,
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/status-bar": "^8.0.3",
    "cra-template": "1.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-helmet-async": "^2.0.5",
    "react-scripts": "^5.0.1",
    "web-vitals": "^4.2.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "mobile:sync": "npm run build && cap sync",
    "ios:open": "npm run mobile:sync && cap open ios",
    "ios:run": "npm run mobile:sync && cap run ios",
    "android:open": "npm run mobile:sync && cap open android",
    "android:run": "npm run mobile:sync && cap run android",
    "assets:generate": "capacitor-assets generate",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "test:colors": "react-scripts test ColorScheme.test.js",
    "test:components": "react-scripts test ComponentColorScheme.test.js",
    "test:all-colors": "react-scripts test ColorScheme.test.js ComponentColorScheme.test.js",
    "test:eslint-hooks": "react-scripts test eslint-hooks.test.js",
    "test:eslint-cli": "react-scripts test eslint-cli.test.js",
    "test:lint": "react-scripts test --testMatch=\"**/eslint*.test.js\"",
    "test:build-warnings": "react-scripts test build-warnings.test.js",
    "test:hooks-linting": "react-scripts test hooks-linting.test.js",
    "test:clean-build": "react-scripts test clean-build.test.js",
    "verify-hooks": "npm run test:clean-build",
    "verify-hooks-fix": "./src/tests/verify-hooks-fix.sh"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "jest": "^27.5.1",
    "mock-component": "^5.1.0",
    "msw": "^2.7.3"
  }
}
