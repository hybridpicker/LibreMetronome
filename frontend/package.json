{
  "name": "frontend",
  "version": "0.8.0",
  "buildNumber": 8,
  "private": true,
  "dependencies": {
    "@capacitor/android": "~8.4.3",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "~8.4.3",
    "@capacitor/ios": "~8.4.3",
    "@capacitor/status-bar": "^8.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "mobile:sync": "npm run build && cap sync",
    "ios:open": "npm run mobile:sync && cap open ios",
    "ios:run": "npm run mobile:sync && cap run ios",
    "android:open": "npm run mobile:sync && cap open android",
    "android:run": "npm run mobile:sync && cap run android",
    "assets:generate": "capacitor-assets generate",
    "test": "react-scripts test",
    "test:ci": "CI=true react-scripts test --watchAll=false",
    "coverage": "CI=true react-scripts test --watchAll=false --coverage",
    "lint": "eslint src --ext .js,.jsx --max-warnings 0",
    "eject": "react-scripts eject",
    "test:colors": "react-scripts test ColorScheme.test.js",
    "test:components": "react-scripts test ComponentColorScheme.test.js",
    "test:all-colors": "react-scripts test ColorScheme.test.js ComponentColorScheme.test.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "~8.4.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "eslint-plugin-security": "^4.2.0",
    "playwright-core": "^1.64.1",
    "react-scripts": "^5.0.1"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/tests/**",
      "!src/**/__mocks__/**",
      "!src/**/*.test.{js,jsx}",
      "!src/setupTests.js"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 98,
        "branches": 95,
        "functions": 98,
        "lines": 98
      }
    }
  },
  "overrides": {
    "nth-check": "^2.1.1",
    "postcss": "^8.5.23",
    "serialize-javascript": "^7.1.3",
    "node-forge": "^1.4.0",
    "underscore": "^1.13.8",
    "tar": "^7.5.21",
    "uuid": "^11.1.1",
    "svgo": "^3.3.2",
    "css-select": "^5.1.0",
    "bfj": "^9.1.3",
    "jsonpath": "^1.3.0"
  }
}
